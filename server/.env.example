# Copy this file to .env and adjust for your environment.
# In local dev, every one of these has a working default baked into the
# code (see db.js, auth.js, presenceBridge.js, server.js) - you only need
# a real .env file once you deploy somewhere with different connection
# details or want a non-default JWT secret.

PORT=1234
DATABASE_URL=postgres://docedit:docedit_dev_password@localhost:5432/docedit
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
# Your deployed frontend's exact origin, e.g. https://your-app.vercel.app
# Leave unset locally - it defaults to "*" (allow any origin).
CORS_ORIGIN=

# Gmail SMTP - sends verification emails as your own Gmail address, no
# domain verification needed, delivers to any real inbox immediately.
# Leave both unset and the code just prints the code to this server's
# console instead - the verification FLOW still works either way.
#
# GMAIL_USER is the full Gmail address to send from.
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your normal Gmail
# password - generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the account first).
GMAIL_USER=
GMAIL_APP_PASSWORD=
